{
  "name": "cue",
  "version": "0.1.0",
  "description": "Open-source Windows and macOS AI overlay — screen, microphone, and system audio into an LLM.",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "pack:win": "electron-builder --win --dir",
    "dist": "electron-builder --mac zip",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "screencapturekit",
    "macos",
    "windows"
  ],
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "lucide-static": "^0.468.0",
    "openai": "^4.73.0"
  }
}
